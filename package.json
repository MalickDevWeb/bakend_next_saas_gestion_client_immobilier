{
  "name": "next-backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:qualite": "npm run lint && npm run typecheck",
    "test:fonctionnalite": "npm run test:qualite",
    "test:endpoints:admin": "bash scripts/test-endpoints-admin.sh",
    "test:endpoints:super-admin": "bash scripts/test-endpoints-super-admin.sh",
    "test:endpoints:all": "bash scripts/test-tous-endpoints-api.sh",
    "qualite:score": "node scripts/evaluer-qualite-code.mjs",
    "gate:fonctionnalite": "npm run test:qualite && npm run qualite:score",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.0",
    "jose": "^5.9.6",
    "next": "16.1.6",
    "otplib": "^12.0.1",
    "prisma": "^6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.32.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5"
  }
}
